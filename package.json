{
  "name": "oc-sample",
  "version": "1.0.0",
  "description": "Fastify weather API",
  "main": "dist/index.js",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:web\"",
    "dev:server": "tsx watch src/index.ts",
    "dev:web": "cd front && npm run dev",
    "build": "npm run build:server && npm run build:web",
    "build:server": "tsc",
    "build:web": "cd front && npm run build",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit && cd front && npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "cd front && npm run lint",
    "format": "cd front && npm run format"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^9.1.3",
    "dotenv": "^16.5.0",
    "fastify": "^5.8.5"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "concurrently": "^9.2.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vitest": "^4.0.17"
  }
}
